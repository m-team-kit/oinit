# # if you uncomment this block, make sure that the default site
# # that might come with a clean nginx install is disabled
# # i.e. rm /etc/nginx/sites-enabled/default
# server {
#     listen 80;
#     server_name localhost;
#     return 301 https://$server_name$request_uri;
# }

server {
    listen 8081;
    listen [::]:8081;

    # listen 8444 ssl;
    # listen [::]:8444 ssl;
    # ssl_certificate /etc/ssl/private/nginx.pem;
    # ssl_certificate_key /etc/ssl/private/nginx.key;
    # ssl_certificate /etc/letsencrypt/live/ssh-oidc-demo.data.kit.edu/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ssh-oidc-demo.data.kit.edu/privkey.pem;

    server_name _;
    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        # we don't want nginx trying to do something clever with
        # redirects, we set the Host: header above already.
        proxy_redirect off;
        proxy_pass http://localhost:8082
    }
}
